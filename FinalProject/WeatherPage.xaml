<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProject.WeatherPage"
             Title="WeatherPage"
             BackgroundColor="White">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="270"/>
        </Grid.RowDefinitions>

        <Label x:Name="CityNameLabel"
               FontSize="30"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Grid.Row="0"/>

        <StackLayout Grid.Row="1" Padding="40" Spacing="5">
            <Label x:Name="TemperatureLabel"
                   Text="--°C"
                   FontSize="50"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label x:Name="WeatherDescriptionLabel"
                   Text="Weather Description"
                   FontSize="20"
                   HorizontalOptions="Center"/>
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                <Label Text="Humidity: " FontSize="16"/>
                <Label x:Name="HumidityLabel" Text="--%" FontSize="16"/>
            </StackLayout>
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                <Label Text="Precipitation: " FontSize="16"/>
                <Label x:Name="PrecipitationLabel" Text="--mm" FontSize="16"/>
            </StackLayout>
            <Image x:Name="WeatherIcon" WidthRequest="100" HeightRequest="100" Aspect="AspectFit" Margin="0,0,0,20"/>
            <BoxView HeightRequest="1"
                BackgroundColor="LightGray"
                HorizontalOptions="FillAndExpand"/>
        </StackLayout>

        <CollectionView x:Name="HourlyCollectionView"
                        HeightRequest="200"
                        ItemsLayout="HorizontalList"
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="LightGray"
                    BorderColor="Silver"
                    Padding="10"
                    CornerRadius="15"
                    Margin="3,5"
                    HasShadow="True">
                        <StackLayout Orientation="Vertical" Padding="10" HorizontalOptions="Center">
                            <Label Text="{Binding FormattedTime, StringFormat='Time: {0}'}" FontSize="14" HorizontalOptions="Center"/>
                            <Image Source="{Binding WeatherImage}" WidthRequest="70" HeightRequest="70" />
                            <Label Text="{Binding Temperature, StringFormat='Temp:{0}°C'}" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="{Binding Humidity, StringFormat='RH: {0}%'}" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="{Binding Precipitation, StringFormat='PoP: {0}mm'}" FontSize="14" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>