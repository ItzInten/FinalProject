<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProject.TranslatorPage"
             Title="TranslatorPage">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Entry x:Name="txtInput" Placeholder="Enter text to translate" FontSize="18"/>

        <Picker x:Name="languagePicker" Title="Select Language" FontSize="18"/>

        <Button Text="Translate" Clicked="OnTranslateClicked" FontSize="18" />

        <Label x:Name="lblTranslation" FontSize="20" TextColor="Blue" Text="Translation will appear here." 
           Padding="10" BackgroundColor="LightGray" HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
</ContentPage>