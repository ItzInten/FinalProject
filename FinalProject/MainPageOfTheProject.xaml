<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProject.MainPageOfTheProject"
             xmlns:local="clr-namespace:FinalProject"
             Title="MainPageOfTheProject">
    <ContentPage Title="Exchange">
        <ContentPage.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A1C4FD" Offset="0.1"/>
                <GradientStop Color="#C2E9FB" Offset="3.0"/>
            </LinearGradientBrush>
        </ContentPage.Background>
        <VerticalStackLayout>
            <Label Text="Currency Converter"
               FontSize="24"
               HorizontalOptions="Center"
               VerticalOptions="Start" 
               Margin="0,50,0,100" />
            <ScrollView>
            <Frame CornerRadius="15" 
                    Padding="15" 
                    BackgroundColor="White"
                    HasShadow="True"
                    WidthRequest="350"
                    HeightRequest="260">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto, *">
                        <Picker x:Name="FromCurrencyPicker" Title="From" WidthRequest="120"/>
                        <Button Text="⇄" Clicked="OnSwapCurrencies" Grid.Column="1"/>
                        <Picker x:Name="ToCurrencyPicker" Title="To" Grid.Column="2" WidthRequest="120"/>
                    </Grid>

                    <Entry x:Name="AmountEntry"
               Placeholder="Enter amount"
               Keyboard="Numeric"
               HorizontalOptions="FillAndExpand"/>

                    <Button Text="Convert" Clicked="OnShowResultClicked"/>

                    <Label x:Name="ResultLabel" Text="Result: " FontSize="20" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

        </ScrollView>
        </VerticalStackLayout>
    </ContentPage>

    <local:WeatherPage Title="Weather" />

    <local:MapPage Title="Map" />
    
    <local:TranslatorPage Title="Translate"/>
</TabbedPage>