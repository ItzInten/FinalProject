<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FinalProject"
             x:Class="FinalProject.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ThemedLabelStyle" TargetType="Label">
                <Setter Property="TextColor">
                    <Setter.Value>
                        <AppThemeBinding Light="Black" Dark="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ThemedPickerStyle" TargetType="Picker">
                <Setter Property="TextColor">
                    <Setter.Value>
                        <AppThemeBinding Light="Black" Dark="White"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="TitleColor">
                    <Setter.Value>
                        <AppThemeBinding Light="Black" Dark="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
